# ALINED — Environment Variables
# Copy this file to .env.local for local development
# Add these as Environment Variables in Vercel Dashboard for production

# ── Telemetry backend ─────────────────────────────────────────────────────────
# The URL your front-end posts behavioural manifests to.
# Format: https://your-vercel-domain.vercel.app/api/telemetry/session
VITE_TELEMETRY_ENDPOINT=https://your-app.vercel.app/api/telemetry/session

# Restrict CORS to your deployed domain (optional — defaults to *)
ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Supabase (server-side only — never expose these to the front-end) ─────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here
