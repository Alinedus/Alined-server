{
  "name": "alined",
  "version": "1.0.0",
  "description": "Architectural Drawing App - Transform sketches into professional CAD drawings",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "mobile:init": "npx cap init",
    "mobile:add-android": "npx cap add android",
    "mobile:add-ios": "npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/cli": "^5.5.1",
    "@capacitor/core": "^5.5.1",
    "@capacitor/ios": "^5.5.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "architecture",
    "cad",
    "drawing",
    "autocad",
    "dxf",
    "floor-plan",
    "sketching",
    "ocr",
    "handwriting-recognition"
  ],
  "author": {
    "name": "Naman Alex",
    "email": "namanalex@gmail.com",
    "url": "https://github.com/namanalex"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/namanalex/alined.git"
  },
  "bugs": {
    "url": "https://github.com/namanalex/alined/issues"
  },
  "homepage": "https://github.com/namanalex/alined#readme"
}
